---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config';

const path = '/outils/calcul-retenue-a-la-source';
const base = Astro.site?.toString().replace(/\/$/, '') ?? site.url;
const faqs = [
  { q: 'Sur quel montant se calcule la retenue de 1,5 % ?', a: "Sur le montant TTC de la facture, TVA comprise, lorsque ce montant atteint 1 000 DT." },
  { q: 'Qui effectue la retenue ?', a: "Le client qui paie. Il verse au fournisseur le net à payer (TTC moins la retenue) et reverse la retenue à l'administration fiscale. Le fournisseur reçoit un certificat de retenue." },
  { q: 'Le taux de 1,5 % vaut-il pour toutes les opérations ?', a: "Non. Le taux dépend de la nature de l'opération et de la situation du fournisseur. Ce calculateur applique 1,5 % à partir de 1 000 DT TTC : vérifiez le taux qui vous concerne avec votre expert-comptable." },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Calculateur de retenue à la source (Tunisie)',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Tous',
    url: `${base}${path}`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'TND' },
    publisher: { '@type': 'Organization', name: site.publisher },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Alfa ERP', item: `${base}/` },
      { '@type': 'ListItem', position: 2, name: 'Calcul de la retenue à la source', item: `${base}${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title="Calcul retenue à la source 1,5 % Tunisie (gratuit) | Alfa ERP"
  description="Calculez la retenue à la source de 1,5 % sur une facture tunisienne : montant TTC, retenue et net à payer, au millime. Gratuit, sans inscription."
  path={path}
  jsonLd={jsonLd}
>
  <Nav />
  <main id="contenu">
    <section class="tool">
      <div class="wrap tool-grid">
        <div class="copy">
          <nav aria-label="Fil d'Ariane" class="crumbs"><a href="/">Alfa ERP</a><span aria-hidden="true">/</span><span>Outils</span></nav>
          <h1>Calcul de la retenue à la source (1,5 %)</h1>
          <p class="lead">
            Saisissez le montant de la facture. Le calculateur donne le TTC, la retenue et le net à
            payer, arrondis au millime.
          </p>
        </div>

        <form class="calc" data-calc aria-label="Calculateur de retenue à la source">
          <fieldset>
            <legend>Le montant saisi est</legend>
            <label><input type="radio" name="basis" value="ht" checked /> Hors taxes (HT)</label>
            <label><input type="radio" name="basis" value="ttc" /> Toutes taxes comprises (TTC)</label>
          </fieldset>
          <label class="field">
            <span>Montant en DT</span>
            <input name="amount" type="number" inputmode="decimal" min="0" step="0.001" value="2500" required />
          </label>
          <label class="field" data-vat-field>
            <span>Taux de TVA</span>
            <select name="vat"><option value="19">19 %</option><option value="13">13 %</option><option value="7">7 %</option><option value="0">Exonéré</option></select>
          </label>

          <dl class="out" aria-live="polite">
            <div><dt>Montant HT</dt><dd class="figures" data-o="net"></dd></div>
            <div><dt>TVA</dt><dd class="figures" data-o="vat"></dd></div>
            <div><dt>Montant TTC</dt><dd class="figures" data-o="gross"></dd></div>
            <div class="rs"><dt>Retenue à la source 1,5 %</dt><dd class="figures" data-o="wh"></dd></div>
            <div class="pay"><dt>Net à payer au fournisseur</dt><dd class="figures"><span data-o="pay"></span> <small>DT</small></dd></div>
          </dl>
          <p class="note" data-o="note"></p>
        </form>
      </div>
    </section>

    <section class="section explain">
      <div class="wrap prose">
        <h2>Comment se calcule la retenue à la source</h2>
        <p>
          Dans le cas courant calculé ici, l'entreprise qui paie une facture de 1 000 DT TTC ou plus
          retient 1,5 % du montant TTC et ne verse au fournisseur que le reste. La retenue est ensuite reversée à
          l'administration fiscale.
        </p>
        <h3>Exemple</h3>
        <p>Une facture de 2 500,000 DT HT avec une TVA de 19 % :</p>
        <ul>
          <li>TVA : 2 500,000 × 19 % = 475,000 DT</li>
          <li>TTC : 2 975,000 DT, donc au-dessus du seuil de 1 000 DT</li>
          <li>Retenue : 2 975,000 × 1,5 % = 44,625 DT</li>
          <li>Net à payer au fournisseur : 2 930,375 DT</li>
        </ul>
        <p>
          Les montants sont arrondis au millime, la plus petite unité du dinar. Ce calculateur
          donne une indication ; pour une opération particulière, demandez confirmation à votre
          expert-comptable.
        </p>

        <div class="faq">
          <h2>Questions fréquentes</h2>
          {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
        </div>

        <aside class="pitch">
          <h2>Facturez sans calculatrice</h2>
          <p>
            Alfa ERP calcule la TVA de chaque facture au millime, imprime vos documents à votre
            image et passe l'écriture comptable tout seul. Essayez-le gratuitement sur votre PC.
          </p>
          <div class="ctas">
            <a class="btn btn-primary" href="/telecharger" data-download><Icon name="download" size={18} /> Télécharger Alfa ERP</a>
            <a class="btn btn-ghost" href="/logiciel-facturation-tunisie">Voir la facturation</a>
          </div>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  import { computeInvoice, formatTnd } from '../../lib/invoice';
  const form = document.querySelector<HTMLFormElement>('[data-calc]');
  if (form) {
    const o = (k: string) => form.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const update = () => {
      const fd = new FormData(form);
      const raw = parseFloat(String(fd.get('amount') ?? '0').replace(',', '.'));
      const amount = Number.isFinite(raw) && raw > 0 ? raw : 0;
      const rate = Number(fd.get('vat'));
      const ttcBasis = fd.get('basis') === 'ttc';
      // A TTC entry is converted back to HT so the VAT and rounding match an invoice line.
      const net = ttcBasis ? amount / (1 + rate / 100) : amount;
      const t = ttcBasis
        ? (() => {
            const gross = Math.round(amount * 1000) / 1000;
            const vat = Math.round(((gross * rate) / (100 + rate)) * 1000) / 1000;
            const base = computeInvoice([{ quantity: 1, unitPrice: gross, vatRate: 0 }]);
            return { ...base, net: gross - vat, vat };
          })()
        : computeInvoice([{ quantity: 1, unitPrice: net, vatRate: rate }]);
      o('net').textContent = formatTnd(t.net);
      o('vat').textContent = formatTnd(t.vat);
      o('gross').textContent = formatTnd(t.gross);
      o('wh').textContent = t.withholding ? `−${formatTnd(t.withholding)}` : '0,000';
      o('pay').textContent = formatTnd(t.payable);
      o('note').textContent = t.withholding
        ? 'Le TTC atteint 1 000 DT : la retenue s\'applique.'
        : `Le TTC est inférieur à 1 000 DT : pas de retenue.`;
    };
    form.addEventListener('input', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    update();
  }
</script>

<style>
  .tool { padding-block: clamp(28px, 5vw, 64px) clamp(40px, 6vw, 72px); }
  .tool-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 56px); align-items: start; }
  .copy { display: grid; gap: 18px; }
  .crumbs { display: flex; gap: 8px; font-size: var(--t-sm); color: var(--muted); }
  .crumbs a { color: var(--violet-deep); text-decoration: none; }
  h1 { font-size: clamp(2rem, 1.3rem + 2.6vw, 3rem); line-height: 1.06; letter-spacing: -0.022em; }
  .lead { font-size: var(--t-lg); color: var(--ink-2); max-width: 46ch; }

  .calc { background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-l); padding: 24px; display: grid; gap: 16px; box-shadow: var(--shadow-window); }
  fieldset { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; }
  legend { font-weight: 600; font-size: var(--t-sm); margin-bottom: 8px; }
  fieldset label { display: inline-flex; gap: 8px; align-items: center; font-size: var(--t-sm); cursor: pointer; }
  input[type='radio'] { accent-color: var(--violet-deep); width: 18px; height: 18px; }
  .field { display: grid; gap: 6px; font-size: var(--t-sm); font-weight: 600; }
  .field input, .field select { min-height: 48px; border: 1px solid var(--line-strong); border-radius: 8px; padding: 8px 12px; font: 400 var(--t-md) var(--body); background: #fff; color: var(--ink); }
  .field input { font-family: var(--figures); }
  .field input:focus, .field select:focus { outline: 2px solid var(--violet); outline-offset: 0; }
  .out { margin: 4px 0 0; display: grid; gap: 6px; padding-top: 14px; border-top: 1px solid var(--line); }
  .out div { display: flex; justify-content: space-between; gap: 12px; }
  .out dt { color: var(--ink-2); }
  .out dd { margin: 0; }
  .rs dd { color: var(--credit); }
  .pay { margin-top: 4px; padding-top: 10px; border-top: 2px solid var(--ink); font-weight: 600; font-size: var(--t-lg); }
  .pay small { font-size: var(--t-xs); color: var(--muted); }
  .note { font-size: var(--t-sm); color: var(--muted); }

  .explain { background: var(--surface); border-top: 1px solid var(--line); }
  .prose { max-width: 760px; display: grid; gap: 16px; }
  .prose p, .prose li { color: var(--ink-2); }
  .prose ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; font-family: var(--figures); font-size: var(--t-sm); }
  .faq { margin-top: 24px; display: grid; }
  .faq h2 { margin-bottom: 8px; }
  details { border-bottom: 1px solid var(--line-strong); }
  summary { cursor: pointer; padding: 14px 0; font: 600 var(--t-md)/1.4 var(--display); }
  details p { padding-bottom: 14px; }
  .pitch { margin-top: 28px; padding: 24px; border-radius: var(--radius-l); background: var(--tint); display: grid; gap: 12px; }
  .pitch h2 { font-size: var(--t-lg); }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 900px) { .tool-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
