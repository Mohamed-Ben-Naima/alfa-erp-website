---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Facts from '../components/Facts.astro';
import Pains from '../components/Pains.astro';
import InvoiceDemo from '../components/InvoiceDemo.astro';
import ProductTour from '../components/ProductTour.astro';
import VideoStory from '../components/VideoStory.astro';
import Steps from '../components/Steps.astro';
import Team from '../components/Team.astro';
import Pricing from '../components/Pricing.astro';
import Roadmap from '../components/Roadmap.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { faqs } from '../lib/faqs';
import { video, site } from '../config';
const base = Astro.site?.toString().replace(/\/$/, '') ?? site.url;
const videoLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Alfa ERP : une vente complète, du devis à la comptabilité',
  description: "Démonstration filmée dans Alfa ERP : devis, bon de commande, bon de livraison, facture, écriture comptable, stock et balance âgée.",
  thumbnailUrl: `${base}${video.poster}`,
  contentUrl: `${base}${video.src}`,
  uploadDate: video.uploadDate,
  duration: video.durationIso,
  inLanguage: 'fr',
  hasPart: video.chapters.map((c, i, all) => ({ '@type': 'Clip', name: c.title, startOffset: c.t, endOffset: all[i + 1]?.t ?? 120, url: `${base}/#demo` })),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---
<Base
  title="Logiciel de gestion commerciale Tunisie | Alfa ERP"
  description="Factures, stock, encaissements et comptabilité dans un seul logiciel tunisien. TVA, plan comptable tunisien, dinar à 3 décimales. Sans internet. Essai gratuit."
  jsonLd={[faqLd, videoLd]}
>
  <Nav />
  <main id="contenu">
    <Hero />
    <Facts />
    <Pains />
    <InvoiceDemo />
    <ProductTour />
    <VideoStory />
    <Steps />
    <Team />
    <Pricing />
    <Roadmap />
    <Faq />
  </main>
  <Footer />
</Base>
