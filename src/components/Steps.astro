---
import { release } from '../config';
// A real sequence, so numbering is meaningful here.
const steps = [
  {
    title: 'Téléchargez',
    text: `Un fichier pour ${release.requirements}. Sans droits administrateur.`,
  },
  {
    title: 'Essayez en mode démo',
    text: "Une société d'exemple déjà remplie : clients, articles, factures.",
  },
  {
    title: 'Activez votre licence',
    text: 'Saisissez votre numéro de série. Tout ce que vous avez saisi est conservé.',
  },
];
---
<section class="section steps" aria-labelledby="steps-title">
  <div class="wrap">
    <div class="section-head">
      <div class="rule" aria-hidden="true"></div>
      <h2 id="steps-title">Prêt en trois étapes</h2>
    </div>
    <ol>
      {steps.map((s, i) => (
        <li>
          <span class="n figures" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; counter-reset: s; }
  li { padding: 8px 28px 8px 0; display: grid; gap: 10px; align-content: start; position: relative; }
  li + li { padding-left: 28px; border-left: 1px solid var(--line-strong); }
  .n {
    width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
    background: var(--ink); color: #fff; font-weight: 600; font-size: var(--t-md);
  }
  li:last-child .n { background: var(--violet-deep); }
  p { color: var(--ink-2); font-size: var(--t-sm); max-width: 38ch; }
  @media (max-width: 820px) {
    ol { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    li, li + li { padding: 0 0 0 20px; border-left: 2px solid var(--line-strong); }
  }
</style>
