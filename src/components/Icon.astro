---
// Small inline icon set (stroke icons, 24px grid). Decorative unless a label is given.
interface Props { name: string; size?: number; label?: string; class?: string }
const { name, size = 20, label, class: cls } = Astro.props;
const paths: Record<string, string> = {
  download: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>',
  whatsapp: '<path d="M3.5 20.5 5 16a8.5 8.5 0 1 1 3.2 3.1Z"/><path d="M9.2 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .6a6 6 0 0 0 2.6 2.4c.2.1.4.1.6-.1l.6-.6c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5v.4c0 .4-.2.8-.6 1a3 3 0 0 1-2.4.3 9 9 0 0 1-5.6-5.4 2.6 2.6 0 0 1 .4-2.4Z"/>',
