---
import fs from 'node:fs';
import path from 'node:path';
import Icon from './Icon.astro';
import { team, whatsappLink, messages, site } from '../config';

// A photo shows as soon as its file is dropped into public/team/; until then, a monogram.
const people = team.map((p) => ({
  ...p,
  hasPhoto: fs.existsSync(path.join(process.cwd(), 'public', p.photo)),
  initials: p.name.split(' ').map((w) => w[0]).slice(0, 2).join(''),
}));
---
<section class="section team" id="equipe" aria-labelledby="team-title">
  <div class="wrap team-grid">
    <div class="intro">
      <img class="company" src="/brand/alfa-computers-logo.png" alt="Alfa Computers" width="400" height="107" loading="lazy" />
      <h2 id="team-title">Deux développeurs tunisiens que vous pouvez appeler</h2>
      <p>
        Alfa ERP est conçu et développé à Mahdia, chez {site.publisher}, par les deux
        personnes ci-contre. Vous parlez directement à l'équipe qui écrit le logiciel.
      </p>
      <a class="btn btn-wa" href={whatsappLink(messages.general)} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} class="wa-dot" />
        Écrire à l'équipe
      </a>
    </div>

    <div class="people">
      {people.map((p) => (
        <article class="person">
          <div class="portrait">
            {p.hasPhoto ? (
              <img src={p.photo} alt={`Portrait de ${p.name}`} width="400" height="400" loading="lazy" />
            ) : (
              <span class="monogram" aria-hidden="true">{p.initials}</span>
            )}
          </div>
          <div class="person-text">
            <h3>{p.name}</h3>
            <p class="role">{p.role}</p>
            {p.line && <blockquote>{p.line}</blockquote>}
            {p.linkedin && (
              <a class="li" href={p.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={18} />LinkedIn</a>
            )}
          </div>
        </article>
      ))}

      <figure class="signature">
        <a href="/shots/a-propos.webp" data-zoom><img src="/shots/a-propos.webp" alt="Fenêtre « À propos » d'Alfa ERP : éditeur Alfa Computers & Consulting, auteurs Ferid HELALI et Mohamed Ben Naima" width="771" height="506" loading="lazy" /></a>
        <figcaption>Nos deux noms sont dans le logiciel lui-même : menu Aide, puis « À propos ».</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .team-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .intro { display: grid; gap: 18px; position: sticky; top: 100px; }
  .company { width: 200px; height: auto; }
  .intro p { color: var(--ink-2); }
  .intro .btn { justify-self: start; }

  .people { display: grid; gap: 20px; }
  .person {
    display: grid; grid-template-columns: 148px minmax(0, 1fr); gap: 24px; align-items: center;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-l); padding: 20px;
  }
  .portrait {
    width: 148px; aspect-ratio: 1; border-radius: 50%; padding: 4px; background: var(--brand-gradient);
  }
  .portrait img, .monogram {
    width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 4px solid var(--surface); background: var(--tint);
  }
  .monogram { display: grid; place-items: center; font: 700 2.6rem/1 var(--display); color: var(--violet-deep); letter-spacing: -0.03em; }
  .person-text { display: grid; gap: 6px; }
  .role { color: var(--violet-deep); font-weight: 500; font-size: var(--t-sm); }
  blockquote { margin: 6px 0 0; font-family: var(--display); font-size: var(--t-md); line-height: 1.45; color: var(--ink); font-weight: 450; }
  blockquote::before { content: '« '; color: var(--magenta); }
  blockquote::after { content: ' »'; color: var(--magenta); }
  .li { display: inline-flex; gap: 6px; align-items: center; font-size: var(--t-sm); color: var(--muted); margin-top: 4px; }

  .signature { margin: 8px 0 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: 20px; align-items: center; }
  .signature img { border-radius: var(--radius-m); border: 1px solid var(--line-strong); box-shadow: var(--shadow-window); }
  figcaption { font-size: var(--t-sm); color: var(--muted); }

  @media (max-width: 900px) {
    .team-grid { grid-template-columns: minmax(0, 1fr); }
    .intro { position: static; }
  }
  @media (max-width: 560px) {
    .person { grid-template-columns: minmax(0, 1fr); justify-items: start; }
    .portrait { width: 112px; }
    .signature { grid-template-columns: minmax(0, 1fr); }
  }
</style>
