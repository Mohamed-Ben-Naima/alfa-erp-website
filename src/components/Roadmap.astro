---
import Icon from './Icon.astro';
import { whatsappLink, messages } from '../config';
---
<section class="roadmap" aria-labelledby="roadmap-title">
  <div class="wrap">
    <div class="box">
      <p class="tag">En préparation</p>
      <div class="text">
        <h2 id="roadmap-title">Facture électronique El Fatoora</h2>
        <p>Pas encore disponible. En préparation : format TEIF, signature électronique, envoi à TTN. Incluse dans votre licence.</p>
      </div>
      <a class="btn btn-ghost" href={whatsappLink(messages.einvoice)} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={18} />
        Me prévenir
      </a>
    </div>
  </div>
</section>

<style>
  .roadmap { padding-block: 0; }
  .box {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 16px 28px; align-items: center;
    padding: 26px 28px; border-radius: var(--radius-l); background: #fff8ee; border: 1px solid #f3d9b4;
  }
  .tag {
    align-self: start; padding: 6px 12px; border-radius: 999px; background: var(--amber); color: #3a2000;
    font-weight: 600; font-size: var(--t-xs); white-space: nowrap;
  }
  .text { display: grid; gap: 8px; }
  h2 { font-size: var(--t-lg); }
  .text p { color: var(--ink-2); font-size: var(--t-sm); max-width: 70ch; }
  @media (max-width: 820px) {
    .box { grid-template-columns: minmax(0, 1fr); }
    .tag { justify-self: start; }
    .btn { justify-self: start; }
  }
</style>
