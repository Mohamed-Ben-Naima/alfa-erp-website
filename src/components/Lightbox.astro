---
// One shared viewer. Any link marked data-zoom opens its image here instead of a new tab;
// without JavaScript the link still opens the image itself.
---
<dialog class="lightbox" data-lightbox aria-label="Image agrandie">
  <form method="dialog" class="lb-close-form">
    <button class="lb-close" type="submit" aria-label="Fermer">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </form>
  <figure>
    <img data-lb-img alt="" />
    <figcaption data-lb-caption></figcaption>
  </figure>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = dlg?.querySelector<HTMLImageElement>('[data-lb-img]');
  const cap = dlg?.querySelector<HTMLElement>('[data-lb-caption]');
  let opener: HTMLElement | null = null;

  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-zoom]');
    if (!link || !dlg || !img || !cap || typeof dlg.showModal !== 'function') return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // keep "open in new tab"
    e.preventDefault();
    const thumb = link.querySelector('img');
    img.src = link.href;
    img.alt = thumb?.alt ?? '';
    cap.textContent = link.dataset.caption ?? thumb?.alt ?? '';
    opener = link;
    dlg.showModal();
    document.documentElement.classList.add('lb-open');
  });

  // Click on the backdrop (outside the figure) closes.
  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });
  dlg?.addEventListener('close', () => {
    document.documentElement.classList.remove('lb-open');
    if (img) img.removeAttribute('src');
    opener?.focus();
  });
</script>

<style>
  .lightbox {
    width: min(1280px, 96vw); max-width: none; max-height: 94vh; padding: 0; border: 0;
    background: transparent; overflow: visible;
  }
  .lightbox::backdrop { background: rgba(20, 14, 28, 0.82); backdrop-filter: blur(3px); }
  .lightbox[open] { animation: lb-in .18s ease-out; }
  @keyframes lb-in { from { opacity: 0; transform: scale(.98); } to { opacity: 1; transform: none; } }
  figure { margin: 0; display: grid; gap: 10px; }
  img { width: 100%; height: auto; max-height: calc(94vh - 60px); object-fit: contain; border-radius: 10px; background: #fff; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
  figcaption { color: #f1ecf7; font-size: var(--t-sm); text-align: center; }
  .lb-close-form { position: absolute; top: -14px; right: -14px; z-index: 2; margin: 0; }
  .lb-close {
    width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer; display: grid; place-items: center;
    background: #fff; color: var(--ink); box-shadow: 0 4px 16px rgba(0,0,0,.35);
  }
  .lb-close:hover { background: var(--tint); }
  @media (max-width: 640px) { .lb-close-form { top: -52px; right: 0; } }
  :global(html.lb-open) { overflow: hidden; }
  :global(a[data-zoom]) { cursor: zoom-in; }
</style>
