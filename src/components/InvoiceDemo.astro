---
import Icon from './Icon.astro';
---
<section class="section demo" id="essayer" aria-labelledby="demo-title">
  <div class="wrap">
    <div class="section-head">
      <div class="rule" aria-hidden="true"></div>
      <h2 id="demo-title">Essayez une facture, ici</h2>
      <p>Changez une quantité ou un taux de TVA. Totaux et écriture comptable se calculent au millime.</p>
    </div>

    <div class="demo-grid" data-demo>
      <div class="left">
      <div class="window editor">
        <div class="window-bar"><img src="/brand/alfa-mark.png" alt="" width="16" height="15" />Factures clients, FA2026-0021<span class="ctrl" aria-hidden="true">— ▢ ✕</span></div>
        <div class="editor-body">
          <div class="client">
            <span>Client</span>
            <strong>Atelier Mécanique Slim, Hebira</strong>
          </div>

          <div class="lines-head" aria-hidden="true">
            <span>Article</span><span class="num">Qté</span><span class="num">P.U. HT</span><span>TVA</span><span class="num">Total HT</span><span></span>
          </div>
          <ol class="lines" data-lines aria-label="Lignes de la facture"></ol>

          <div class="editor-actions">
            <button type="button" class="btn btn-ghost add" data-add>
              <Icon name="plus" size={18} /> Ajouter une ligne
            </button>
            <label class="toggle">
              <input type="checkbox" data-wh />
              <span>Simuler la retenue à la source (1,5 %)</span>
            </label>
          </div>
        </div>
      </div>
      <div class="entry">
          <p class="entry-title">Écriture passée au journal des ventes</p>
          <table>
            <thead><tr><th scope="col">Compte</th><th scope="col" class="num">Débit</th><th scope="col" class="num">Crédit</th></tr></thead>
            <tbody data-entry></tbody>
          </table>
          <p class="entry-note">Équilibrée, datée, numérotée. Votre comptable n'a rien à ressaisir.</p>
        </div>
      </div>

      <aside class="results" aria-live="polite">
        <dl class="totals">
          <div><dt>Total HT</dt><dd class="figures" data-out="net"></dd></div>
          <div data-vat-rows></div>
          <div class="gross"><dt>Total TTC</dt><dd class="figures" data-out="gross"></dd></div>
          <div class="rs"><dt>Retenue à la source 1,5 %</dt><dd class="figures" data-out="wh"></dd></div>
          <div class="pay"><dt>Net à payer</dt><dd class="figures"><span data-out="payable"></span> <small>TND</small></dd></div>
        </dl>
        <p class="hint" data-hint></p>

      </aside>
    </div>

    <div class="demo-cta">
      <p>Alfa ERP le fait pour chaque facture, automatiquement.</p>
      <a class="btn btn-primary" href="/telecharger" data-download>
        <Icon name="windows" size={18} /> Télécharger gratuitement
      </a>
    </div>
  </div>
</section>

<template id="line-tpl">
  <li class="line">
    <label class="f-article"><span class="sr-only">Article</span><select data-f="article"></select></label>
    <label class="f-qty"><span class="lbl">Qté</span><input data-f="qty" type="number" inputmode="decimal" min="0" step="any" /></label>
    <label class="f-price"><span class="lbl">P.U. HT</span><input data-f="price" type="number" inputmode="decimal" min="0" step="0.001" /></label>
    <label class="f-vat"><span class="lbl">TVA</span>
      <select data-f="vat"><option value="19">19 %</option><option value="13">13 %</option><option value="7">7 %</option><option value="0">Exonéré</option></select>
    </label>
    <output class="f-total figures" data-f="total"></output>
    <button type="button" class="remove" data-f="remove" aria-label="Supprimer la ligne">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V4.5h6V7"/><path d="M6.5 7l1 13h9l1-13"/></svg>
    </button>
  </li>
</template>

<script>
  import { computeInvoice, formatTnd } from '../lib/invoice';

  type Line = { article: string; qty: number; price: number; vat: number };
  const catalog: Record<string, { label: string; price: number; vat: number }> = {
    'CHARN-100': { label: 'Charnière inox 100 mm', price: 6.9, vat: 19 },
    'PERC-750': { label: 'Perceuse à percussion 750 W', price: 189, vat: 19 },
    'CAB-2.5': { label: 'Câble électrique 2,5 mm² (100 m)', price: 118, vat: 19 },
    'PEINT-BL20': { label: 'Peinture acrylique blanche 20 L', price: 145, vat: 19 },
    'ROB-MIT': { label: 'Robinet mitigeur de lavabo', price: 89, vat: 19 },
    'GANT-CUIR': { label: 'Gants de manutention en cuir', price: 8.5, vat: 19 },
    'LIV-CHANT': { label: 'Livraison sur chantier', price: 25, vat: 19 },
  };

  const root = document.querySelector<HTMLElement>('[data-demo]');
  const tpl = document.getElementById('line-tpl') as HTMLTemplateElement | null;
  if (root && tpl) {
    const list = root.querySelector<HTMLOListElement>('[data-lines]')!;
    const wh = root.querySelector<HTMLInputElement>('[data-wh]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const vatRows = root.querySelector<HTMLElement>('[data-vat-rows]')!;
    const entry = root.querySelector<HTMLElement>('[data-entry]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;

    let lines: Line[] = [
      { article: 'CHARN-100', qty: 120, price: 6.9, vat: 19 },
      { article: 'PERC-750', qty: 2, price: 189, vat: 19 },
    ];

    const num = (v: string) => {
      const n = parseFloat(v.replace(',', '.'));
      return Number.isFinite(n) && n >= 0 ? n : 0;
    };

    function renderLines() {
      list.replaceChildren();
      lines.forEach((l, i) => {
        const node = tpl!.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        const sel = node.querySelector<HTMLSelectElement>('[data-f="article"]')!;
        for (const [code, a] of Object.entries(catalog)) {
          const o = document.createElement('option');
          o.value = code;
          o.textContent = a.label;
          sel.append(o);
        }
        sel.value = l.article;
        const qty = node.querySelector<HTMLInputElement>('[data-f="qty"]')!;
        const price = node.querySelector<HTMLInputElement>('[data-f="price"]')!;
        const vat = node.querySelector<HTMLSelectElement>('[data-f="vat"]')!;
        qty.value = String(l.qty);
        price.value = l.price.toFixed(3);
        vat.value = String(l.vat);
        sel.addEventListener('change', () => {
          const a = catalog[sel.value];
          lines[i] = { ...lines[i], article: sel.value, price: a.price, vat: a.vat };
          price.value = a.price.toFixed(3);
          vat.value = String(a.vat);
          update();
        });
        qty.addEventListener('input', () => { lines[i].qty = num(qty.value); update(); });
        price.addEventListener('input', () => { lines[i].price = num(price.value); update(); });
        vat.addEventListener('change', () => { lines[i].vat = Number(vat.value); update(); });
        node.querySelector('[data-f="remove"]')!.addEventListener('click', () => {
          lines.splice(i, 1);
          renderLines();
          update();
          (list.querySelector('select') as HTMLElement | null)?.focus();
        });
        list.append(node);
      });
    }

    function row(account: string, label: string, debit: number, credit: number) {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td><span class="acc figures">${account}</span>${label}</td><td class="num figures">${debit ? formatTnd(debit) : ''}</td><td class="num figures">${credit ? formatTnd(credit) : ''}</td>`;
      return tr;
    }

    function update() {
      const t = computeInvoice(
        lines.map((l) => ({ quantity: l.qty, unitPrice: l.price, vatRate: l.vat })),
        wh.checked,
      );
      list.querySelectorAll<HTMLOutputElement>('[data-f="total"]').forEach((o, i) => {
        const l = lines[i];
        o.textContent = formatTnd(computeInvoice([{ quantity: l.qty, unitPrice: l.price, vatRate: 0 }]).net);
      });
      out('net').textContent = formatTnd(t.net);
      out('gross').textContent = formatTnd(t.gross);
      out('wh').textContent = t.withholding ? `−${formatTnd(t.withholding)}` : '0,000';
      out('payable').textContent = formatTnd(t.payable);

      vatRows.replaceChildren(
        ...t.vatByRate.filter((v) => v.rate > 0).map((v) => {
          const d = document.createElement('div');
          d.className = 'trow';
          d.innerHTML = `<dt>TVA ${v.rate} %</dt><dd class="figures">${formatTnd(v.amount)}</dd>`;
          return d;
        }),
      );

      if (!wh.checked) hint.textContent = 'Cochez « Simuler la retenue » pour voir le net à payer après retenue.';
      else if (t.withholding) hint.textContent = 'Simulation : le TTC atteint 1 000 DT, la retenue de 1,5 % s\'applique.';
      else hint.textContent = `Simulation : pas de retenue, il manque ${formatTnd(1000 - t.gross)} DT TTC pour atteindre le seuil de 1 000 DT.`;

      entry.replaceChildren(
        row('41100000', 'Clients', t.payable, 0),
        ...(t.withholding ? [row('432000', 'État, retenue à la source (simulation)', t.withholding, 0)] : []),
        row('706000', 'Ventes', 0, t.net),
        ...(t.vat ? [row('43670000', 'TVA collectée', 0, t.vat)] : []),
      );
    }

    root.querySelector('[data-add]')!.addEventListener('click', () => {
      const used = new Set(lines.map((l) => l.article));
      const code = Object.keys(catalog).find((c) => !used.has(c)) ?? 'LIV-CHANT';
      lines.push({ article: code, qty: 1, price: catalog[code].price, vat: catalog[code].vat });
      renderLines();
      update();
      const last = list.lastElementChild?.querySelector<HTMLInputElement>('[data-f="qty"]');
      last?.focus();
      last?.select();
    });
    wh.addEventListener('change', update);

    renderLines();
    update();
  }
</script>

<style>
  .demo-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .editor-body { padding: 18px; display: grid; gap: 12px; }
  .client { display: flex; gap: 10px; align-items: baseline; font-size: var(--t-sm); padding-bottom: 6px; }
  .client span { color: var(--muted); }

  .lines-head, :global(.demo .line) {
    display: grid; grid-template-columns: minmax(0, 2.6fr) 70px 104px 92px 96px 36px; gap: 8px; align-items: center;
  }
  .lines-head { font-size: var(--t-xs); color: var(--muted); padding: 0 2px 4px; border-bottom: 1px solid var(--line-strong); }
  .num { text-align: right; }
  .lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  :global(.demo .line) { padding: 4px 2px; border-bottom: 1px solid var(--line); }
  :global(.demo .line select), :global(.demo .line input) {
    width: 100%; min-height: 40px; border: 1px solid var(--line-strong); border-radius: 6px; background: #fff;
    font: 400 var(--t-sm)/1.2 var(--body); color: var(--ink); padding: 6px 8px;
  }
  :global(.demo .line input) { font-family: var(--figures); text-align: right; }
  :global(.demo .line select:focus), :global(.demo .line input:focus) { outline: 2px solid var(--app-blue); outline-offset: 0; border-color: var(--app-blue); }
  :global(.demo .line .lbl) { display: none; }
  :global(.demo .f-total) { text-align: right; font-size: var(--t-sm); }
  :global(.demo .remove) {
    width: 36px; height: 36px; display: grid; place-items: center; border: 0; background: none; color: var(--muted);
    border-radius: 6px; cursor: pointer;
  }
  :global(.demo .remove:hover) { color: var(--bad); background: #fbeef1; }

  .editor-actions { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; justify-content: space-between; padding-top: 6px; }
  .add { min-height: 42px; padding: 8px 14px; }
  .toggle { display: inline-flex; gap: 10px; align-items: center; font-size: var(--t-sm); cursor: pointer; }
  .toggle input { width: 20px; height: 20px; accent-color: var(--violet-deep); }

  .results { background: var(--ink); color: #f3eff8; border-radius: var(--radius-m); padding: 22px; display: grid; gap: 14px; position: sticky; top: 88px; }
  .totals { margin: 0; display: grid; gap: 6px; }
  .totals > div:not([data-vat-rows]), .totals :global(.trow) { display: flex; justify-content: space-between; gap: 12px; }
  [data-vat-rows] { display: grid; gap: 6px; }
  [data-vat-rows]:empty { display: none; }
  .totals dt { color: #cfc6dc; }
  .totals dd { margin: 0; }
  .gross { padding-top: 6px; border-top: 1px solid rgba(255,255,255,.18); }
  .rs dd { color: #ffc27a; }
  .pay { margin-top: 4px; padding-top: 10px; border-top: 2px solid #fff; font-size: var(--t-lg); font-weight: 600; }
  .pay dt { color: #fff; }
  .pay small { font-size: var(--t-xs); color: #cfc6dc; }
  .hint { font-size: var(--t-xs); color: #cfc6dc; min-height: 2.6em; }

  .left { display: grid; gap: 16px; min-width: 0; }
  .entry { background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--radius-m); padding: 16px 18px; }
  .entry-title { font-weight: 600; font-size: var(--t-sm); margin-bottom: 8px; font-family: var(--display); }
  .entry table { width: 100%; border-collapse: collapse; font-size: var(--t-sm); }
  .entry th { text-align: left; font-weight: 500; color: var(--muted); font-size: var(--t-xs); padding: 4px 2px; border-bottom: 1px solid var(--line-strong); }
  .entry th.num { text-align: right; }
  :global(.demo .entry td) { padding: 7px 2px; border-bottom: 1px solid var(--line); }
  :global(.demo .entry td.num) { text-align: right; white-space: nowrap; width: 22%; }
  :global(.demo .entry .acc) { display: inline-block; min-width: 92px; color: var(--violet-deep); font-size: var(--t-xs); }
  .entry-note { margin-top: 10px; font-size: var(--t-xs); color: var(--muted); }

  .demo-cta { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; justify-content: space-between; padding: 20px 24px; border: 1px dashed var(--line-strong); border-radius: var(--radius-m); }
  .demo-cta p { font-family: var(--display); font-size: var(--t-lg); font-weight: 550; max-width: 44ch; }

  @media (max-width: 1020px) {
    .demo-grid { grid-template-columns: minmax(0, 1fr); }
    .results { position: static; }
  }
  @media (max-width: 680px) {
    .lines-head { display: none; }
    :global(.demo .line) {
      grid-template-columns: 1fr 1fr 1fr; grid-template-areas: 'a a a' 'q p v' 't t r';
      padding: 12px 0; gap: 8px;
    }
    :global(.demo .f-article) { grid-area: a; }
    :global(.demo .f-qty) { grid-area: q; }
    :global(.demo .f-price) { grid-area: p; }
    :global(.demo .f-vat) { grid-area: v; }
    :global(.demo .f-total) { grid-area: t; text-align: left; font-weight: 600; align-self: center; }
    :global(.demo .remove) { grid-area: r; justify-self: end; }
    :global(.demo .line .lbl) { display: block; font-size: 11px; color: var(--muted); margin-bottom: 2px; }
    .editor-body { padding: 14px; }
  }
</style>
