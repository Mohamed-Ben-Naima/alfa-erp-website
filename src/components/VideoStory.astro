---
import Icon from './Icon.astro';
import { video } from '../config';
---
<section class="section video" id="demo" aria-labelledby="video-title">
  <div class="wrap video-grid">
    <div class="video-copy">
      <div class="rule" aria-hidden="true"></div>
      <h2 id="video-title">Une vente de A à Z, en 2 minutes</h2>
      <p>Filmé dans le vrai logiciel : devis, livraison, facture, comptabilité et stock.</p>
      <ul class="chapters">
        {video.chapters.map((c) => (
          <li><button type="button" data-seek={c.t}><span class="figures">{c.label}</span>{c.title}</button></li>
        ))}
      </ul>
      <a class="btn btn-primary" href="/telecharger" data-download>
        <Icon name="windows" size={18} /> Télécharger gratuitement
      </a>
    </div>
    <div class="player window">
      <video
        controls
        playsinline
        preload="none"
        poster={video.poster}
        width="1920"
        height="1080"
        data-video
        aria-label="Démonstration d'Alfa ERP : une vente du devis à la facture, avec voix off et sous-titres"
      >
        <source src={video.src} type="video/mp4" />
        <track kind="captions" srclang="fr" label="Français" src={video.captions} />
      </video>
    </div>
  </div>
</section>

<script>
  const v = document.querySelector<HTMLVideoElement>('[data-video]');
  document.querySelectorAll<HTMLButtonElement>('[data-seek]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!v) return;
      v.currentTime = Number(b.dataset.seek);
      v.play().catch(() => {});
      v.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }),
  );
</script>

<style>
  .video { background: var(--ink); color: #f3eff8; }
  .video h2 { color: #fff; }
  .video-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr); gap: clamp(28px, 4vw, 56px); align-items: center; }
  .video-copy { display: grid; gap: 18px; justify-items: start; }
  .video-copy p { color: #d8d0e3; }
  .chapters { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; width: 100%; }
  .chapters button {
    width: 100%; display: flex; gap: 12px; align-items: baseline; text-align: left; cursor: pointer;
    background: none; border: 0; border-radius: 8px; padding: 7px 10px; color: #e9e3f1; font: 500 var(--t-sm)/1.3 var(--body);
  }
  .chapters button:hover { background: rgba(255, 255, 255, .08); color: #fff; }
  .chapters .figures { color: var(--amber); font-size: var(--t-xs); min-width: 38px; }
  .video-copy .btn-primary { background: #fff; color: var(--violet-deep); }
  .player { border-color: rgba(255,255,255,.14); background: #000; }
  video { width: 100%; aspect-ratio: 16 / 9; background: #000; }
  @media (max-width: 900px) {
    .video-grid { grid-template-columns: minmax(0, 1fr); }
    .player { order: -1; }
  }
</style>
